# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ===========================================
# REQUIRED: Telegram Bot Configuration
# ===========================================

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ===========================================
# REQUIRED: Admin Notifications
# ===========================================

# Your Telegram user ID for receiving scanner stats
# Get it by sending a message to @userinfobot on Telegram
ADMIN_CHAT_ID=your_telegram_user_id_here

# ===========================================
# OPTIONAL: AWS Configuration
# ===========================================

# AWS Region for DynamoDB (default: eu-central-1)
AWS_REGION=eu-central-1

# ===========================================
# OPTIONAL: Scanner Configuration
# ===========================================

# Maximum pages to scan on initial run (default: 3)
# MAX_PAGES_INITIAL=3

# Maximum pages to scan on regular runs (default: 1)
# MAX_PAGES_REGULAR=1

# Maximum item IDs to store per search (default: 200)
# MAX_STORED_IDS=200

# Scanner start hour in Israel time (default: 6 = 6 AM)
# SCAN_START_HOUR=6

# Scanner end hour in Israel time (default: 24 = midnight)
# SCAN_END_HOUR=24